# ==============================================================================
# FRAGMENT — Unified Environment Variables Template (.env.example)
# Copy this file to .env or .env.local and fill in your private API keys.
# ==============================================================================

# ── 1. Core Platform Identity ──────────────────────────────────────────────────
PROJECT_NAME="FRAGMENT - Adversarial Model Risk Validation Platform"
API_V1_STR="/api/v1"

# ── 2. JWT & Session Security ─────────────────────────────────────────────────
# Secret key used for cryptographic token signing and model AST execution integrity
SECRET_KEY="your_64_character_random_secret_key_here"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── 3. Database Engine & Persistence ──────────────────────────────────────────
# Local SQLite default (auto-switches to /tmp/fragment.db on Vercel serverless)
DATABASE_URL="sqlite+aiosqlite:///./fragment.db"
SQLITE_FALLBACK_URL="sqlite+aiosqlite:///./fragment.db"
USE_POSTGRES=false

# ── 4. Cache & Queue Engine ───────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379/0"

# ── 5. OpenRouter AI Reasoning & SR 11-7 Report Synthesis ─────────────────────
# Powers automated quantitative model risk reviews and AST code synthesis
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY="your_openrouter_api_key_here"
OPENROUTER_MODEL="google/gemini-2.5-flash"

# ── 6. Frontend Client Routing ────────────────────────────────────────────────
# Leave EMPTY for local dev & standard Vercel deployment (auto-resolves /api/v1).
NEXT_PUBLIC_API_URL=

# ── 7. Market Data & Quantitative Benchmarks (Optional) ───────────────────────
# Stock prices & volatility surfaces are queried live via Yahoo Finance.
# ALPHA_VANTAGE_API_KEY=""
# FRED_API_KEY=""
# POLYGON_API_KEY=""
